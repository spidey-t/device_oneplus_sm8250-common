# diag_use() is gated behind userdebug_or_eng() upstream; this is a user build,
# so re-grant /dev/diag access to hal_bluetooth which is denied (audit 74):
# avc: denied { read write } for comm="bluetooth@1.0-s"
# scontext=u:r:hal_bluetooth_default:s0 tcontext=u:object_r:vendor_diag_device:s0
diag_use(hal_bluetooth)